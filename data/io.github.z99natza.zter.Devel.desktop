[Desktop Entry]
Type=Application
Name=zter (Development)
Comment=Development build of zter
Exec=zter-devel
Icon=io.github.z99natza.zter.Devel
Terminal=false
NoDisplay=true
Actions=new-tab;new-window;
StartupNotify=false
StartupWMClass=io.github.z99natza.zter.Devel

[Desktop Action new-tab]
Name=New Tab
Exec=zter-devel --new-tab

[Desktop Action new-window]
Name=New Standalone Window
Exec=zter-devel --standalone
